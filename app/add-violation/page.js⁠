'use client';
import { useState } from 'react';

export default function AddViolationPage() {
  const [loading, setLoading] = useState(false);
  const [whatsappLink, setWhatsappLink] = useState('');
  const [formData, setFormData] = useState({
    student_id: '',
    student_name: '',
    grade_level: '',
    class_room: '',
    violation_type: '',
    parent_phone: '',
    degree: 1,
    action_taken: '',
    parent_notified: false
  });

  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);
    setWhatsappLink('');

    try {
      const response = await fetch('/api/violations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
      });

      const result = await response.json();

      if (result.success) {
        alert('✅ تم حفظ المخالفة في النظام بنجاح!');

        // تجهيز رابط الواتساب إذا تم إدخال رقم
        if (formData.parent_phone) {
          const message = `السلام عليكم ورحمة الله وبركاته،\nولي أمر الطالب/ة: ${formData.student_name} المحترم،\n\nنود إبلاغكم بأنه تم تسجيل ملاحظة سلوكية على ابنكم/ابنتكم اليوم.\n\n📌 *نوع المخالفة:* ${formData.violation_type}\n🛠 *الإجراء المتخذ:* ${formData.action_taken}\n\nنرجو منكم متابعة الأمر، وشكراً لتعاونكم المستمر.\n*إدارة المدرسة*`;
          
          // إزالة أي مسافات من الرقم لضمان عمل الرابط
          const phone = formData.parent_phone.replace(/\D/g, '');
          const link = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
          setWhatsappLink(link);
        }

        // تفريغ الحقول باستثناء رقم الهاتف واسم الطالب مؤقتاً لتسهيل الإرسال
        setFormData({
          student_id: '',
          student_name: '',
          grade_level: '',
          class_room: '',
          violation_type: '',
          parent_phone: '',
          degree: 1,
          action_taken: '',
          parent_notified: false
        });
      } else {
        alert('❌ حدث خطأ أثناء الحفظ');
      }
    } catch (err) {
      alert('❌ تعذر الاتصال بالخادم');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{ maxWidth: '500px', margin: '20px auto', padding: '20px', direction: 'rtl', fontFamily: 'sans-serif' }}>
      <h2 style={{ textAlign: 'center', color: '#1e293b' }}>تسجيل مخالفة سلوكية</h2>
      
      <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
        <input type="text" placeholder="رقم الطالب / السجل" required style={{ padding: '10px', borderRadius: '6px', border: '1px solid #ccc' }} value={formData.student_id} onChange={e => setFormData({...formData, student_id: e.target.value})} />
        <input type="text" placeholder="اسم الطالب" required style={{ padding: '10px', borderRadius: '6px', border: '1px solid #ccc' }} value={formData.student_name} onChange={e => setFormData({...formData, student_name: e.target.value})} />
        <input type="text" placeholder="الصف الدراسي (مثال: السادس)" required style={{ padding: '10px', borderRadius: '6px', border: '1px solid #ccc' }} value={formData.grade_level} onChange={e => setFormData({...formData, grade_level: e.target.value})} />
        <input type="text" placeholder="الفصل / الشعبة (مثال: 6/1)" required style={{ padding: '10px', borderRadius: '6px', border: '1px solid #ccc' }} value={formData.class_room} onChange={e => setFormData({...formData, class_room: e.target.value})} />
        <input type="text" placeholder="نوع المخالفة" required style={{ padding: '10px', borderRadius: '6px', border: '1px solid #ccc' }} value={formData.violation_type} onChange={e => setFormData({...formData, violation_type: e.target.value})} />
        
        {/* حقل رقم هاتف ولي الأمر الجديد */}
        <input type="tel" placeholder="رقم واتساب ولي الأمر (مثال: 96891234567)" required style={{ padding: '10px', borderRadius: '6px', border: '2px solid #25D366' }} value={formData.parent_phone} onChange={e => setFormData({...formData, parent_phone: e.target.value})} />

        <select value={formData.degree} onChange={e => setFormData({...formData, degree: Number(e.target.value)})} style={{ padding: '10px', borderRadius: '6px', border: '1px solid #ccc' }}>
          <option value={1}>درجة المخالفة: الأولى (بسيطة)</option>
          <option value={2}>درجة المخالفة: الثانية (متوسطة)</option>
          <option value={3}>درجة المخالفة: الثالثة (خطيرة)</option>
        </select>
        <textarea placeholder="الإجراء المتخذ" required rows={3} style={{ padding: '10px', borderRadius: '6px', border: '1px solid #ccc' }} value={formData.action_taken} onChange={e => setFormData({...formData, action_taken: e.target.value})} />

        <button type="submit" disabled={loading} style={{ padding: '12px', backgroundColor: '#0070f3', color: '#fff', border: 'none', borderRadius: '6px', fontSize: '16px', cursor: 'pointer' }}>
          {loading ? 'جاري الحفظ...' : 'حفظ المخالفة في النظام'}
        </button>
      </form>

      {/* زر إرسال الواتساب يظهر فقط بعد حفظ المخالفة بنجاح */}
      {whatsappLink && (
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" style={{ display: 'block', textAlign: 'center', padding: '12px', backgroundColor: '#25D366', color: '#fff', textDecoration: 'none', borderRadius: '6px', fontWeight: 'bold', marginTop: '15px', fontSize: '16px' }}>
          💬 إرسال إشعار لولي الأمر عبر الواتساب
        </a>
      )}
    </div>
  );
}
